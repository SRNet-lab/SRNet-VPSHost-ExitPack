         _router.on_connected(
             [this] {
-                if (_route_poker and _route_poker->enabled() and not _router.config().exit.ranges.empty())
+                if (_route_poker and _route_poker->enabled() and _router.has_exit_ranges())
                     _route_poker->put_up();
             },
             /*with_paths=*/false,
@@ -370,6 +372,7 @@ namespace srouter::handlers
     {
         // Only remotes listed in exit.ranges are exit brokers for inbound return traffic.
         // Do not treat an arbitrary exit-policy ClientContact peer as a broker.
+        std::shared_lock lock{_router.exit_ranges_mutex()};
         return _router.config().exit.ranges.contains(remote);
     }
 
@@ -378,6 +381,7 @@ namespace srouter::handlers
         // Longest-prefix match when ranges overlap (deterministic).
         std::optional<NetworkAddress> best;
         int best_mask = -1;
+        std::shared_lock lock{_router.exit_ranges_mutex()};
         for (const auto& [exit_addr, range_list] : _router.config().exit.ranges)
         {
             for (const auto& r : range_list)
@@ -405,6 +409,7 @@ namespace srouter::handlers
     {
         std::optional<NetworkAddress> best;
         int best_mask = -1;
+        std::shared_lock lock{_router.exit_ranges_mutex()};
         for (const auto& [exit_addr, range_list] : _router.config().exit.ranges)
         {
             for (const auto& r : range_list)
diff --git a/src/router/router.hpp b/src/router/router.hpp
index 2c0b821..7e1facb 100644
--- a/src/router/router.hpp
+++ b/src/router/router.hpp
@@ -21,6 +21,7 @@
 #include <chrono>
 #include <functional>
 #include <memory>
+#include <shared_mutex>
 #include <type_traits>
 
 namespace oxenmq
@@ -113,6 +114,8 @@ namespace srouter
 
         Config _config;
 
+        mutable std::shared_mutex _exit_ranges_mtx;
+
       public:
         const std::shared_ptr<quic::Loop> _loop;
 
@@ -270,8 +273,17 @@ namespace srouter
         const Config& config() const { return _config; }
 
         // Runtime MapExit / unmap_exit mutate reserved-range mappings.
+        // RPC (OMQ thread) writes and the packet path (TUN/loop thread) reads these
+        // ranges. Writers hold exit_ranges_mutex() exclusively; readers hold it shared.
+        // Never call into routing/session code while holding the exclusive lock.
         auto& mutable_exit_ranges() { return _config.exit.ranges; }
         const auto& exit_ranges() const { return _config.exit.ranges; }
+        std::shared_mutex& exit_ranges_mutex() const { return _exit_ranges_mtx; }
+        bool has_exit_ranges() const
+        {
+            std::shared_lock lock{_exit_ranges_mtx};
+            return not _config.exit.ranges.empty();
+        }
 
         ContactDB& contact_db()
         {
